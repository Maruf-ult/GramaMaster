using GramaMaster.Application.DTOs.Authentication;
using GramaMaster.Application.DTOs.Common;
using GramaMaster.Application.Interfaces.Persistence;
using GramaMaster.Application.Interfaces.Security;
using GramaMaster.Application.Interfaces.Services;
using GramaMaster.Domain.Entities;
using GramaMaster.Domain.Enums;

namespace GramaMaster.Application.Services
{
    public class AuthService : IAuthService
    {
        private readonly IUnitOfWork _unitOfWork;
        private readonly IPasswordHasher _passwordHasher;
        private readonly ITokenService _tokenService;
        private readonly IEmailService _emailService;

        public AuthService(
            IUnitOfWork unitOfWork,
            IPasswordHasher passwordHasher,
            ITokenService tokenService,
            IEmailService emailService)
        {
            _unitOfWork = unitOfWork;
            _passwordHasher = passwordHasher;
            _tokenService = tokenService;
            _emailService = emailService;
        }

        public async Task<ApiResponse<LoginResponseDto>> RegisterStudentAsync(RegisterStudentDto dto)
        {
            // Validate the DTO
            if (string.IsNullOrWhiteSpace(dto.Email) || string.IsNullOrWhiteSpace(dto.Password))
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { "Email and password cannot be empty" },
                    "Email and password are required");
            }

            // Check if email already exists
            var existingUser = await _unitOfWork.Users.GetByEmailAsync(dto.Email);
            if (existingUser != null)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { $"User with email {dto.Email} already exists" },
                    "Email already registered");
            }

            // Validate password confirmation
            if (dto.Password != dto.ConfirmPassword)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { "Password and confirm password do not match" },
                    "Password mismatch");
            }

            // Get curriculum based on curriculum type
            var curriculums = await _unitOfWork.Curriculums.FindAsync(c => 
                c.Name.Contains(dto.CurriculumType.ToString()));
            if (curriculums == null || curriculums.Count == 0)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { $"Curriculum for {dto.CurriculumType} not found" },
                    "Curriculum not found");
            }

            var curriculum = curriculums.FirstOrDefault();

            // Create new user
            var user = new User
            {
                Id = Guid.NewGuid(),
                FullName = dto.FullName,
                Email = dto.Email,
                PasswordHash = _passwordHasher.Hash(dto.Password),
                Role = UserRole.Student,
                IsActive = true
            };

            // Create student entity
            var student = new Student
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                User = user,
                ProfileImageUrl = dto.ProfileImageUrl,
                InstitutionName = dto.InstitutionName,
                CurriculumType = dto.CurriculumType,
                CurriculumId = curriculum!.Id,
                Curriculum = curriculum,
                Group = dto.Group,
                ExamBatchYear = dto.ExamBatchYear,
                Board = dto.Board
            };

            user.Student = student;

            // Add to database
            await _unitOfWork.Users.AddAsync(user);
            await _unitOfWork.SaveChangesAsync();

            // Generate tokens
            var accessToken = _tokenService.GenerateAccessToken(user);
            var refreshToken = _tokenService.GenerateRefreshToken();

            // Create response
            var response = new LoginResponseDto
            {
                UserId = user.Id,
                FullName = user.FullName,
                Email = user.Email,
                Role = user.Role,
                AccessToken = accessToken,
                ExpiresAt = DateTime.UtcNow.AddHours(1) // Default 1 hour expiry
            };

            return ApiResponse<LoginResponseDto>.SuccessResponse(response, "Student registered successfully");
        }

