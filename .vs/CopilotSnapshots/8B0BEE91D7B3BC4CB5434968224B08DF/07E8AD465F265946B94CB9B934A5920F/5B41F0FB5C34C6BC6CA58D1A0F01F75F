        public async Task<ApiResponse<LoginResponseDto>> LoginAsync(LoginDto dto)
        {
            // Validate input
            if (string.IsNullOrWhiteSpace(dto.Email) || string.IsNullOrWhiteSpace(dto.Password))
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { "Email and password are required" },
                    "Invalid credentials");
            }

            // Find user by email
            var user = await _unitOfWork.Users.GetByEmailAsync(dto.Email);
            if (user == null)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { "User not found" },
                    "Invalid credentials");
            }

            // Verify password
            if (!_passwordHasher.Verify(dto.Password, user.PasswordHash))
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { "Incorrect password" },
                    "Invalid credentials");
            }

            // Check if user is active
            if (!user.IsActive)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    new List<string> { "Your account has been disabled" },
                    "Account disabled");
            }

            // Generate tokens
            var accessToken = _tokenService.GenerateAccessToken(user);

            // Create response
            var response = new LoginResponseDto
            {
                UserId = user.Id,
                FullName = user.FullName,
                Email = user.Email,
                Role = user.Role,
                AccessToken = accessToken,
                ExpiresAt = DateTime.UtcNow.AddHours(1) // Default 1 hour expiry
            };

            return ApiResponse<LoginResponseDto>.SuccessResponse(response, "Login successful");
        }

        public async Task<ApiResponse<bool>> ChangePasswordAsync(Guid userId, ChangePasswordDto dto)
        {
            // Validate input
            if (string.IsNullOrWhiteSpace(dto.CurrentPassword) || 
                string.IsNullOrWhiteSpace(dto.NewPassword))
            {
                return ApiResponse<bool>.ErrorResponse(
                    new List<string> { "Current and new passwords are required" },
                    "Invalid input");
            }

            // Validate password confirmation
            if (dto.NewPassword != dto.ConfirmPassword)
            {
                return ApiResponse<bool>.ErrorResponse(
                    new List<string> { "New password and confirm password do not match" },
                    "Password mismatch");
            }

            // Find user
            var user = await _unitOfWork.Users.GetByIdAsync(userId);
            if (user == null)
            {
                return ApiResponse<bool>.ErrorResponse(
                    new List<string> { "User does not exist" },
                    "User not found");
            }

            // Verify current password
            if (!_passwordHasher.Verify(dto.CurrentPassword, user.PasswordHash))
            {
                return ApiResponse<bool>.ErrorResponse(
                    new List<string> { "Current password is incorrect" },
                    "Invalid password");
            }

            // Update password
            user.PasswordHash = _passwordHasher.Hash(dto.NewPassword);
            _unitOfWork.Users.Update(user);
            await _unitOfWork.SaveChangesAsync();

            return ApiResponse<bool>.SuccessResponse(true, "Password changed successfully");
        }

        public async Task<ApiResponse<bool>> ForgotPasswordAsync(ForgotPasswordDto dto)
        {
            // Validate input
            if (string.IsNullOrWhiteSpace(dto.Email))
            {
                return ApiResponse<bool>.ErrorResponse(
                    new List<string> { "Email is required" },
                    "Invalid input");
            }

            // Find user by email
            var user = await _unitOfWork.Users.GetByEmailAsync(dto.Email);
            if (user == null)
            {
                // Return success even if user doesn't exist (security best practice)
                return ApiResponse<bool>.SuccessResponse(true, 
                    "If an account with this email exists, a password reset link has been sent");
            }

            // Generate reset token (using a base64 encoded combination of UserID and timestamp)
            var resetToken = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(
                $"{user.Id}:{DateTime.UtcNow.Ticks}"));

            // Send password reset email
            try
            {
                await _emailService.SendPasswordResetEmailAsync(user.Email, resetToken);
            }
            catch (Exception ex)
            {
                // Log the error but return success to user
                return ApiResponse<bool>.SuccessResponse(true,
                    "If an account with this email exists, a password reset link has been sent");
            }

            return ApiResponse<bool>.SuccessResponse(true,
                "If an account with this email exists, a password reset link has been sent");
        }

        public async Task<ApiResponse<bool>> ResetPasswordAsync(ResetPasswordDto dto)
        {
            // Validate input
            if (string.IsNullOrWhiteSpace(dto.Email) || 
                string.IsNullOrWhiteSpace(dto.Token) || 
                string.IsNullOrWhiteSpace(dto.NewPassword))
            {
                return ApiResponse<bool>.ErrorResponse(
                    "Invalid input",
                    new List<string> { "Email, token, and new password are required" });
            }

            // Validate password confirmation
            if (dto.NewPassword != dto.ConfirmPassword)
            {
                return ApiResponse<bool>.ErrorResponse(
                    "Password mismatch",
                    new List<string> { "New password and confirm password do not match" });
            }

            // Find user by email
            var user = await _unitOfWork.Users.GetByEmailAsync(dto.Email);
            if (user == null)
            {
                return ApiResponse<bool>.ErrorResponse(
                    "Invalid request",
                    new List<string> { "User not found" });
            }

            // Validate token (basic validation - in production, store tokens in database)
            try
            {
                var decodedToken = System.Text.Encoding.UTF8.GetString(
                    Convert.FromBase64String(dto.Token));
                var parts = decodedToken.Split(':');

                if (parts.Length != 2 || !Guid.TryParse(parts[0], out var tokenUserId))
                {
                    return ApiResponse<bool>.ErrorResponse(
                        "Invalid token",
                        new List<string> { "Reset token is invalid or expired" });
                }

                if (tokenUserId != user.Id)
                {
                    return ApiResponse<bool>.ErrorResponse(
                        "Invalid request",
                        new List<string> { "Token does not match the user" });
                }

                // Check if token is expired (tokens valid for 1 hour)
                if (!long.TryParse(parts[1], out var tokenTicks))
                {
                    return ApiResponse<bool>.ErrorResponse(
                        "Invalid token",
                        new List<string> { "Reset token is malformed" });
                }

                var tokenTime = new DateTime(tokenTicks);
                if (DateTime.UtcNow.Subtract(tokenTime).TotalHours > 1)
                {
                    return ApiResponse<bool>.ErrorResponse(
                        "Token expired",
                        new List<string> { "Reset token has expired" });
                }
            }
            catch (Exception)
            {
                return ApiResponse<bool>.ErrorResponse(
                    "Invalid token",
                    new List<string> { "Reset token is invalid" });
            }

            // Update password
            user.PasswordHash = _passwordHasher.Hash(dto.NewPassword);
            _unitOfWork.Users.Update(user);
            await _unitOfWork.SaveChangesAsync();

            return ApiResponse<bool>.SuccessResponse(true, "Password reset successfully");
        }

        public async Task<ApiResponse<LoginResponseDto>> RefreshTokenAsync(RefreshTokenDto dto)
        {
            // Validate input
            if (string.IsNullOrWhiteSpace(dto.RefreshToken))
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    "Invalid token",
                    new List<string> { "Refresh token is required" });
            }

            // Get user ID from expired token (if we're refreshing, the access token is expired)
            // In a real implementation, you'd validate the refresh token against a database
            var userId = _tokenService.GetUserIdFromExpiredToken(dto.RefreshToken);
            if (userId == null || userId == Guid.Empty)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    "Invalid token",
                    new List<string> { "Refresh token is invalid or expired" });
            }

            // Find user
            var user = await _unitOfWork.Users.GetByIdAsync(userId.Value);
            if (user == null || !user.IsActive)
            {
                return ApiResponse<LoginResponseDto>.ErrorResponse(
                    "Invalid request",
                    new List<string> { "User not found or account is disabled" });
            }

            // Generate new access token
            var newAccessToken = _tokenService.GenerateAccessToken(user);

            // Create response
            var response = new LoginResponseDto
            {
                UserId = user.Id,
                FullName = user.FullName,
                Email = user.Email,
                Role = user.Role,
                AccessToken = newAccessToken,
                ExpiresAt = DateTime.UtcNow.AddHours(1) // Default 1 hour expiry
            };

            return ApiResponse<LoginResponseDto>.SuccessResponse(response, "Token refreshed successfully");
        }
    }
